---
import type { CollectionEntry } from 'astro:content';

interface Props {
  path: CollectionEntry<'paths'>;
}

const { path } = Astro.props;
const { title, tagline, effort, stages } = path.data;
---

<a class="card path-card" href={`/paths/${path.id}`}>
  <span class="eyebrow">Learning path</span>
  <h3>{title}</h3>
  <p>{tagline}</p>
  <span class="meta">
    <span>{stages.length} stages</span>
    <span>{effort}</span>
  </span>
</a>
