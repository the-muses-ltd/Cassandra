---
import type { CollectionEntry } from 'astro:content';

interface Props {
  resource: CollectionEntry<'resources'>;
}

const { resource } = Astro.props;
const { title, provider, url, description, subjects, level, format, notes } = resource.data;

// Everything the client-side library filter needs lives in data attributes,
// so filtering works without shipping the collection as JSON.
const searchText = [title, provider, description, subjects.join(' ')].join(' ').toLowerCase();
---

<article
  class="card resource-card"
  data-subjects={subjects.join(' ')}
  data-level={level}
  data-format={format}
  data-search={searchText}
>
  <div class="top-row">
    <span class="badge">{format}</span>
    <span class="badge warm">{level}</span>
  </div>
  <h3><a href={url} rel="noopener">{title}</a></h3>
  <p class="provider">{provider}</p>
  <p class="description">{description}</p>
  {notes && <p class="note">Worth knowing: {notes}</p>}
  <div class="tags">
    {subjects.map((subject) => <span class="tag">{subject.replace(/-/g, ' ')}</span>)}
  </div>
</article>
