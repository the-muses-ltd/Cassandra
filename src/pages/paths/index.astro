---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PathCard from '../../components/PathCard.astro';

const paths = (await getCollection('paths')).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Learning paths — Cassandra Open Education"
  description="Curated, stage-by-stage routes through the best free educational resources: web development, computer science, data analysis and English."
>
  <section class="section">
    <div class="container">
      <h1>Learning paths</h1>
      <p class="lede">
        A path is a route, not a pile of links: ordered stages, the best free resource for each one,
        why it was chosen, and a checkpoint that turns what you learned into something you can show.
      </p>
      <div class="grid wide" style="margin-top: 2rem;">
        {paths.map((path) => <PathCard path={path} />)}
      </div>
      <div class="callout" style="margin-top: 2.5rem; max-width: var(--prose);">
        <p style="margin: 0;">
          <strong>Missing the path you need?</strong> Mathematics, digital literacy and more are
          planned. <a href="/contribute">Propose one or help write it</a> — paths are markdown files
          anyone can draft.
        </p>
      </div>
    </div>
  </section>
</Layout>
