---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ResourceCard from '../components/ResourceCard.astro';

const resources = (await getCollection('resources')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

const subjects = [...new Set(resources.flatMap((r) => r.data.subjects))].sort();
const levels = ['beginner', 'intermediate', 'advanced', 'all'];
const formats = [...new Set(resources.map((r) => r.data.format))].sort();
---

<Layout
  title="Resource library — Cassandra Open Education"
  description="Every resource on Cassandra: hand-vetted, genuinely free courses, books and interactive tutorials from providers built to last."
>
  <section class="section">
    <div class="container">
      <h1>Resource library</h1>
      <p class="lede">
        Every resource referenced by our paths, plus standalone picks. Each one is hand-vetted
        against a simple bar: genuinely free to learn from, high quality, and from a provider likely
        to still exist in five years.
      </p>

      <form class="filter-bar" id="filters" aria-label="Filter resources">
        <div class="search-field">
          <label for="filter-search">Search</label>
          <input
            type="search"
            id="filter-search"
            placeholder="Title, provider, topic…"
            autocomplete="off"
          />
        </div>
        <div>
          <label for="filter-subject">Subject</label>
          <select id="filter-subject">
            <option value="">All subjects</option>
            {
              subjects.map((subject) => (
                <option value={subject}>{subject.replace(/-/g, ' ')}</option>
              ))
            }
          </select>
        </div>
        <div>
          <label for="filter-level">Level</label>
          <select id="filter-level">
            <option value="">Any level</option>
            {levels.map((level) => <option value={level}>{level}</option>)}
          </select>
        </div>
        <div>
          <label for="filter-format">Format</label>
          <select id="filter-format">
            <option value="">Any format</option>
            {formats.map((format) => <option value={format}>{format}</option>)}
          </select>
        </div>
      </form>

      <p class="result-count" id="result-count" aria-live="polite">
        Showing all {resources.length} resources
      </p>

      <div class="grid wide" id="resource-grid">
        {resources.map((resource) => <ResourceCard resource={resource} />)}
      </div>
    </div>
  </section>

  <script>
    // Progressive enhancement: without JavaScript the full library is simply
    // visible; with it, the filter bar narrows the grid in place.
    const search = document.getElementById('filter-search') as HTMLInputElement | null;
    const subject = document.getElementById('filter-subject') as HTMLSelectElement | null;
    const level = document.getElementById('filter-level') as HTMLSelectElement | null;
    const format = document.getElementById('filter-format') as HTMLSelectElement | null;
    const count = document.getElementById('result-count');
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>('#resource-grid .resource-card')
    );

    const apply = () => {
      const q = (search?.value ?? '').trim().toLowerCase();
      const wantSubject = subject?.value ?? '';
      const wantLevel = level?.value ?? '';
      const wantFormat = format?.value ?? '';
      let visible = 0;

      for (const card of cards) {
        const matches =
          (!q || (card.dataset.search ?? '').includes(q)) &&
          (!wantSubject || (card.dataset.subjects ?? '').split(' ').includes(wantSubject)) &&
          (!wantLevel || card.dataset.level === wantLevel) &&
          (!wantFormat || card.dataset.format === wantFormat);
        card.hidden = !matches;
        if (matches) visible += 1;
      }

      if (count) {
        count.textContent =
          visible === cards.length
            ? `Showing all ${cards.length} resources`
            : `Showing ${visible} of ${cards.length} resources`;
      }
    };

    search?.addEventListener('input', apply);
    for (const control of [subject, level, format]) {
      control?.addEventListener('change', apply);
    }
    document.getElementById('filters')?.addEventListener('submit', (e) => e.preventDefault());
  </script>
</Layout>
